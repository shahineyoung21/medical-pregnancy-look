import os
import json
import time
import re
import subprocess
import requests

# ============================================================
# GENIE — وكيل مستقل يُكلَّف بمهمة ولا يتوقف حتى ينجزها
# المبادئ: صدق أولًا — تفكير بايزي — تدوير الاستراتيجيات — لا استسلام
# ============================================================

MAX_STEPS = 12
MAX_STRATEGIES = 5

SYSTEM_PROMPT = """أنت "العفريت" — وكيل ذكاء اصطناعي مستقل، مهمتك إنجاز ما يُكلَّف به مهما كلّف الأمر.

[مبادئك النفسية والمنطقية]:
1. الصدق أولًا: لا تختلق معلومة أبدًا. إن لم تعرف، ابحث. إن فشل البحث، قل صراحةً ما الذي فشل.
2. التفكير البايزي: ابدأ بفرضية، وحدّثها مع كل دليل جديد. لا تتمسك بخطة فاشلة.
3. تفكيك المشكلة: قسّم أي مهمة كبيرة إلى خطوات صغيرة قابلة للتنفيذ.
4. التقدير المنطقي: وزن كل خيار بمعادلة (القيمة ÷ الجهد) واختر الأعلى.
5. الوعي بالإنسان: افهم نية المستخدم الحقيقية وراء النص، وقدّم ما ينفعه فعلًا.
6. عدم الاستسلام: الفشل ليس نهاية، بل بيانات. غيّر الاستراتيجية، لا الهدف.

[طريقة عملك]:
في كل خطوة، أجب بصيغة JSON واحدة فقط، بدون أي نص خارجها:

{"thought": "تفكيرك", "tool": "اسم_الأداة", "input": "مدخل الأداة"}

الأدوات المتاحة:
- search: بحث عميق في الويب. input = عبارة البحث.
- fetch: قراءة محتوى صفحة ويب أو ملف من لينك. input = URL.
- python: تنفيذ كود بايثون (حسابات، تحليل، معالجة نصوص). input = كود بايثون.
- write_file: حفظ نتيجة في ملف. input = JSON نصي {"path": "...", "content": "..."}
- finish: إنهاء المهمة. input = التقرير النهائي الكامل للمستخدم.

قواعد:
- خطوة واحدة فقط في كل رد.
- لا تكرر نفس الأداة بنفس المدخل مرتين.
- عندما تكتمل المهمة تمامًا استخدم finish فورًا.
"""

# ============================================================
# الأدوات (Tools)
# ============================================================

def tool_search(query):
    try:
        from ddgs import DDGS
        results = []
        with DDGS() as ddgs:
            for r in ddgs.text(query, max_results=6):
                results.append(f"- {r['title']}\n  {r['href']}\n  {r['body']}")
        return "\n\n".join(results) if results else "لا نتائج."
    except Exception as e:
        try:
            r = requests.get("https://api.duckduckgo.com/",
                             params={"q": query, "format": "json", "no_html": 1}, timeout=15)
            data = r.json()
            return data.get("AbstractText") or data.get("Answer") or f"فشل البحث: {e}"
        except Exception as e2:
            return f"فشل البحث نهائيًا: {e} | {e2}"


def tool_fetch(url):
    try:
        r = requests.get(url, timeout=20, headers={"User-Agent": "Mozilla/5.0"})
        try:
            from bs4 import BeautifulSoup
            soup = BeautifulSoup(r.text, "html.parser")
            for tag in soup(["script", "style", "nav", "footer"]):
                tag.decompose()
            text = soup.get_text(separator="\n", strip=True)
        except ImportError:
            text = r.text
        return text[:6000]
    except Exception as e:
        return f"فشل قراءة اللينك: {e}"


def tool_python(code):
    try:
        proc = subprocess.run(["python", "-c", code], capture_output=True,
                              text=True, timeout=60)
        out = (proc.stdout + proc.stderr).strip()
        return out[:4000] if out else "(لا مخرجات)"
    except Exception as e:
        return f"فشل تنفيذ الكود: {e}"


def tool_write_file(input_str):
    try:
        spec = json.loads(input_str)
        path = spec["path"]
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(spec["content"])
        return f"تم حفظ الملف: {path}"
    except Exception as e:
        return f"فشل حفظ الملف: {e}"


TOOLS = {
    "search": tool_search,
    "fetch": tool_fetch,
    "python": tool_python,
    "write_file": tool_write_file,
}

# ============================================================
# العقل — تعدد النماذج مع fallback
# ============================================================

def call_llm(messages):
    gemini_key = os.environ.get("GEMINI_API_KEY")
    if gemini_key:
        try:
            import google.generativeai as genai
            genai.configure(api_key=gemini_key)
            history = "\n\n".join(f"[{m['role']}]: {m['content']}" for m in messages)
            for name in ["gemini-2.0-flash", "gemini-1.5-flash", "gemini-1.5-pro"]:
                try:
                    model = genai.GenerativeModel(name)
                    res = model.generate_content(history)
                    if res and res.text:
                        return res.text
                except Exception as e:
                    print(f"Gemini {name} failed: {e}")
        except Exception as e:
            print(f"Gemini init failed: {e}")

    or_key = os.environ.get("OPENROUTER_API_KEY")
    if or_key:
        try:
            res = requests.post(
                "https://openrouter.ai/api/v1/chat/completions",
                headers={"Authorization": f"Bearer {or_key}"},
                json={"model": "openrouter/free", "messages": messages},
                timeout=60)
            if res.status_code == 200:
                return res.json()["choices"][0]["message"]["content"]
        except Exception as e:
            print(f"OpenRouter failed: {e}")
    raise RuntimeError("كل نماذج الذكاء فشلت!")


def parse_action(text):
    match = re.search(r"\{.*\}", text, re.DOTALL)
    if not match:
        return None
    try:
        return json.loads(match.group(0))
    except json.JSONDecodeError:
        return None

# ============================================================
# الحلقة الرئيسية — لا تتوقف حتى الإنجاز
# ============================================================

def run_genie(task, issue_url=None):
    final_report = None
    failure_notes = []

    for strategy_round in range(1, MAX_STRATEGIES + 1):
        print(f"\n===== الجولة الاستراتيجية {strategy_round}/{MAX_STRATEGIES} =====")
        strategy_hint = ""
        if failure_notes:
            strategy_hint = (
                "\n\n[محاولات سابقة فشلت — يجب تغيير الاستراتيجية جذريًا]:\n"
                + "\n".join(failure_notes[-3:])
            )

        messages = [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": f"المهمة المطلوبة:\n{task}{strategy_hint}\n\nابدأ الآن."},
        ]

        for step in range(1, MAX_STEPS + 1):
            print(f"\n--- خطوة {step} ---")
            try:
                reply = call_llm(messages)
            except Exception as e:
                failure_notes.append(f"جولة {strategy_round}: فشل الاتصال بالنموذج: {e}")
                break

            action = parse_action(reply)
            if not action:
                messages.append({"role": "assistant", "content": reply})
                messages.append({"role": "user", "content": "رد غير صالح. أجب بصيغة JSON واحدة فقط حسب التعليمات."})
                continue

            print(f"الفكرة: {action.get('thought', '')[:200]}")
            tool = action.get("tool", "")
            tool_input = action.get("input", "")

            if tool == "finish":
                final_report = tool_input
                break

            if tool not in TOOLS:
                messages.append({"role": "assistant", "content": reply})
                messages.append({"role": "user", "content": f"أداة غير موجودة: {tool}. الأدوات: search, fetch, python, write_file, finish"})
                continue

            print(f"الأداة: {tool} | المدخل: {str(tool_input)[:150]}")
            result = TOOLS[tool](tool_input)
            print(f"النتيجة: {str(result)[:200]}")

            messages.append({"role": "assistant", "content": reply})
            messages.append({"role": "user", "content": f"نتيجة الأداة {tool}:\n{result}\n\nالخطوة التالية؟"})
            time.sleep(1)

        if final_report:
            break
        failure_notes.append(f"جولة {strategy_round}: انتهت الخطوات دون finish.")

    if not final_report:
        final_report = (
            "⚠️ بذلت أقصى جهدي عبر "
            f"{MAX_STRATEGIES} استراتيجيات ولم أكتمل. سجل الفشل:\n"
            + "\n".join(failure_notes)
        )

    os.makedirs("reports", exist_ok=True)
    ts = time.strftime("%Y%m%d_%H%M%S")
    report_path = f"reports/report_{ts}.md"
    with open(report_path, "w", encoding="utf-8") as f:
        f.write(f"# تقرير العفريت 🧞\n\n**المهمة:** {task[:500]}\n\n---\n\n{final_report}")

    with open("agent_log.txt", "a", encoding="utf-8") as f:
        f.write(f"\n--- [GENIE {ts}] Task: {task[:200]} ---\n{final_report[:1000]}\n")

    if issue_url:
        comment_on_issue(issue_url, final_report, report_path)

    send_telegram(f"🧞 *العفريت أنجز مهمة*\n\n{final_report[:3500]}")
    return final_report

# ============================================================
# التكامل مع GitHub و Telegram
# ============================================================

def comment_on_issue(issue_api_url, report, report_path):
    token = os.environ.get("GITHUB_TOKEN")
    if not token:
        return
    try:
        requests.post(
            f"{issue_api_url}/comments",
            headers={"Authorization": f"Bearer {token}",
                     "Accept": "application/vnd.github+json"},
            json={"body": f"## 🧞 تقرير العفريت\n\n{report}\n\n---\n📄 التقرير الكامل محفوظ في `{report_path}`"},
            timeout=20)
    except Exception as e:
        print(f"فشل التعليق على الـ Issue: {e}")


def send_telegram(message):
    bot_token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat_id = os.environ.get("TELEGRAM_CHAT_ID")
    if bot_token and chat_id:
        try:
            requests.post(
                f"https://api.telegram.org/bot{bot_token}/sendMessage",
                json={"chat_id": chat_id, "text": message, "parse_mode": "Markdown"},
                timeout=10)
        except Exception as e:
            print(f"Telegram failed: {e}")


if __name__ == "__main__":
    task = os.environ.get("GENIE_TASK")
    issue_url = os.environ.get("GENIE_ISSUE_URL")
    if not task:
        raise SystemExit("لا توجد مهمة! اضبط GENIE_TASK")
    run_genie(task, issue_url)
